+    db_path = tmp_path / "bad_dim.db"
+
+    with pytest.raises(ValueError, match="hrr_dim must be positive"):
+        MemoryStore(db_path=db_path, hrr_dim=hrr_dim)
+
+    assert not db_path.exists()
+
